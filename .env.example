# =============================================================================
# RootTraceAI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=roottrace
POSTGRES_USER=roottrace
POSTGRES_PASSWORD=changeme

# --- JWT (Phase 2) ---
# JWT_SECRET=your-256-bit-secret-key-here

# --- Gemini AI (Phase 5) ---
# GEMINI_API_KEY=your-gemini-api-key

# --- Frontend Configuration (Phase 10) ---
# FRONTEND_URL=http://localhost:5173

# --- Integrations Configuration (Phase 10) ---
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# --- Webhook Security (Phase 10) ---
# WEBHOOK_SECURITY_ENABLED=false
# WEBHOOK_SECRET=your-webhook-secret-key
